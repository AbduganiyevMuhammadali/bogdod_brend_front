# Dev server (npm run dev) uchun API manzili.
# Vite `.env.production` ni faqat build paytida o'qiydi, shuning uchun dev
# rejimida manzilni shu yerda ko'rsatamiz — aks holda http.js dagi zaxira
# qiymat (localhost:3001) ishlab, lokal bazaga ulanib qoladi.
#
# Lokal backend'da ishlash uchun pastdagi qatorni izohga olib, o'rniga
# VITE_API_URL=http://localhost:3001/api/v1 ni yozing.
VITE_API_URL=http://201.51.11.98:3003/api/v1
